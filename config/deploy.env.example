# Copy to config/deploy.env and fill in. config/deploy.env is ignored by Git.

# SSH destination of the machine that runs passforme-server (user@host or an
# ssh config alias). The user needs sudo there. The first install also needs
# the `passforme` system user and an HTTPS front (e.g. `tailscale serve`);
# see AGENTS.md, Deployment.
DEPLOY_HOST=deploy@pfm.example.com

# Extra ssh/scp options, space separated (optional).
SSH_OPTS="-i $HOME/.ssh/id_ed25519 -o IdentitiesOnly=yes"

# The URL clients use; bin/deploy checks that it answers after the restart.
DEPLOY_URL=https://pfm.example.com
